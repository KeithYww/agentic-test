# All endpoints and IDs below are synthetic. Supply your own services and credentials.
PHOTON_API_BASE_URL=https://llm.example.com
PHOTON_API_KEY=
ORCHESTRATOR_API_KEY=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_JWT_SECRET=
DASHBOARD_PUBLIC_URL=
DESIGN_STATE_DIR=./state
DESIGN_CONTEXT_WINDOW=0
DESIGN_TOKEN_LIMIT=1000000
REQUIREMENT_REVIEW_ENABLED=false
OSS_ARCHIVE_ENABLED=false
PHOTON_OVERLOAD_RETRY_ENABLED=false
PHOTON_REJECTION_CONTRACT=

# Model aliases must exist at your Anthropic-compatible endpoint.
ORCHESTRATOR_CONFIG_MODEL_NAME=your-orchestrator-model
ORCHESTRATOR_CONFIG_FALLBACK_MODEL_NAME=your-orchestrator-fallback
TEST_CASE_GENERATION_AGENT_CONFIG_MODEL_NAME=your-generation-model
TEST_CASE_GENERATION_AGENT_CONFIG_FALLBACK_MODEL_NAME=your-generation-fallback
TEST_CASE_GENERATION_AGENT_CONFIG_REPAIR_MODEL_NAME=your-repair-model
TEST_CASE_REVIEW_AGENT_CONFIG_MODEL_NAME=your-review-model
TEST_CASE_REVIEW_AGENT_CONFIG_FALLBACK_MODEL_NAME=your-review-fallback
TEST_CASE_CLASSIFICATION_AGENT_CONFIG_MODEL_NAME=your-classification-model
TEST_CASE_CLASSIFICATION_AGENT_CONFIG_FALLBACK_MODEL_NAME=your-classification-fallback

# Required by the durable generation flow, including when no matching knowledge exists.
KB_QUERY_ENABLED=true
KB_BASE_URL=https://kb.example.com
KB_API_KEY=

TEST_MANAGEMENT_SYSTEM=meego
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_SYNC_ENABLED=true
FEISHU_BUSINESS_LINE_OPTION_NAMES_JSON={}
FEISHU_DOC_COLLABORATOR_IDS=
FEISHU_BOT_WEBHOOK_URL=
MEEGO_PROJECT_KEY=your-project-key
MEEGO_PLUGIN_ID=
MEEGO_PLUGIN_SECRET=
MEEGO_USER_KEY=
MEEGO_AI_PREGENERATION_NODE_KEY=your-node-key
MEEGO_PROJECT_KEY_MAP_JSON={}
MEEGO_FIELD_STEPS=your-steps-field
MEEGO_FIELD_EXPECTED=your-expected-field
MEEGO_FIELD_LABELS=your-labels-field
MEEGO_FIELD_RELATED_STORY=your-related-story-field
MEEGO_FIELD_TEST_CASES=your-test-cases-field
