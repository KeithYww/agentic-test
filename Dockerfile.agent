# Unified agent image. Set AGENT_MODULE to the Python module name of the agent
# to run (e.g. test_case_generation, test_case_review). All agents share this
# single image; only the AGENT_MODULE env var differs between Deployments.
FROM agentic-qa-base:latest

ARG WORK_DIR=/app
WORKDIR ${WORK_DIR}

COPY agents/ ${WORK_DIR}/agents/
COPY common/ ${WORK_DIR}/common/
COPY config.py ${WORK_DIR}/config.py

# exec replaces the shell so gunicorn becomes PID 1 and receives SIGTERM
# directly, enabling graceful shutdown.
CMD exec gunicorn -w 1 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:${PORT:-8001} agents.${AGENT_MODULE}.main:app
